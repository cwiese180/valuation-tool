# Defaults fail closed. Never commit a populated .env or production exports.
AUTH_MODE=entra
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=https://brwa-intelligence.example.internal
DATABASE_PATH=/var/lib/brwa/brwa.sqlite
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Base64 encoding of 32 random bytes, supplied by the approved secret manager.
SECRET_ENCRYPTION_KEY=
# Explicit Entra object-ID grants, e.g. {"OBJECT-ID":{"role":"reader","clients":["CLIENT-ID"]}}
USER_ACCESS_JSON={}
ENABLE_SOURCE_NETWORK=false
ENABLE_PAID_AI=false
CONNECTORS_CONFIG_PATH=/etc/brwa/connectors.json
